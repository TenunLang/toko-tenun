// Controller Admin — tambah produk.

fungsi cFormAdmin(): teks {
    kembali render("Admin", tampil("admin.batik", peta{}));
}

fungsi cProsesAdmin(): teks {
    kalau panjangTeks(web_form("nama")) == 0 || panjangTeks(web_form("harga")) == 0 {
        flashSet("Nama dan harga wajib diisi.");
        kembali web_redirect("/admin");
    }
    produkBuat(peta{
        "nama": web_form("nama"),
        "jenis": web_form("jenis"),
        "harga": web_form("harga"),
        "stok": web_form("stok"),
        "deskripsi": web_form("deskripsi")
    });
    flashSet("Produk ditambahkan.");
    kembali web_redirect("/");
}
