// Controller Keranjang — tambah, hapus, lihat, checkout. Keranjang = peta id->qty di KV.

fungsi keranjangKunci(): teks {
    kembali "keranjang:" + sesi_dari_cookie();
}

// Muat keranjang sebagai peta id->qty.
fungsi keranjangMuat(): peta {
    biar isi: teks = muat(keranjangKunci());
    biar m: peta = peta{};
    kalau panjangTeks(isi) > 0 {
        biar pasang: []teks = pisah(isi, ",");
        untuk i dari 0 sampai panjang(pasang) {
            biar kv: []teks = pisah(pasang[i], ":");
            kalau panjang(kv) == 2 {
                m[kv[0]] = kv[1];
            }
        }
    }
    kembali m;
}

fungsi keranjangSimpan(m: peta): kosong {
    biar ks: []teks = petaKunci(m);
    biar s: teks = "";
    untuk i dari 0 sampai panjang(ks) {
        kalau i > 0 { s = s + ","; }
        s = s + ks[i] + ":" + m[ks[i]];
    }
    simpan(keranjangKunci(), s);
}

fungsi cTambahKeranjang(): teks {
    biar id: teks = web_param("id");
    biar m: peta = keranjangMuat();
    kalau petaPunya(m, id) {
        m[id] = keTeks(keBulat(m[id]) + 1);
    } lain {
        m[id] = "1";
    }
    keranjangSimpan(m);
    flashSet("Ditambahkan ke keranjang.");
    kembali web_redirect("/keranjang");
}

fungsi cHapusKeranjang(): teks {
    biar m: peta = keranjangMuat();
    petaHapus(m, web_param("id"));
    keranjangSimpan(m);
    kembali web_redirect("/keranjang");
}

fungsi cLihatKeranjang(): teks {
    biar m: peta = keranjangMuat();
    biar ks: []teks = petaKunci(m);
    biar baris: teks = "";
    biar total: bulat = 0;
    untuk i dari 0 sampai panjang(ks) {
        biar p: peta = produkCari(ks[i]);
        kalau petaPunya(p, "id") {
            biar qty: bulat = keBulat(m[ks[i]]);
            biar sub: bulat = keBulat(p["harga"]) * qty;
            total = total + sub;
            baris = baris + "<tr><td>" + esc(p["nama"]) + "</td><td>" + rupiah(p["harga"]) + "</td><td>" + keTeks(qty) + "</td><td>" + rupiah(keTeks(sub)) + "</td><td><a href=\"/keranjang/hapus/" + ks[i] + "\">hapus</a></td></tr>";
        }
    }
    kalau panjangTeks(baris) == 0 {
        baris = "<tr><td colspan=\"5\">Keranjang kosong.</td></tr>";
    }
    kembali render("Keranjang", tampil("keranjang.batik", peta{
        "baris": baris, "total": rupiah(keTeks(total))
    }));
}

fungsi cCheckout(): teks {
    biar m: peta = keranjangMuat();
    biar ks: []teks = petaKunci(m);
    kalau panjang(ks) == 0 {
        flashSet("Keranjang kosong.");
        kembali web_redirect("/keranjang");
    }
    // Validasi stok dulu.
    untuk i dari 0 sampai panjang(ks) {
        biar p: peta = produkCari(ks[i]);
        kalau petaPunya(p, "id") {
            kalau keBulat(m[ks[i]]) > keBulat(p["stok"]) {
                flashSet("Stok " + p["nama"] + " tidak cukup.");
                kembali web_redirect("/keranjang");
            }
        }
    }
    // Proses: kurangi stok, hitung total & ringkasan.
    biar total: bulat = 0;
    biar ringkasan: teks = "";
    untuk j dari 0 sampai panjang(ks) {
        biar p2: peta = produkCari(ks[j]);
        kalau petaPunya(p2, "id") {
            biar qty: bulat = keBulat(m[ks[j]]);
            total = total + keBulat(p2["harga"]) * qty;
            produkUbahStok(ks[j], keTeks(keBulat(p2["stok"]) - qty));
            kalau panjangTeks(ringkasan) > 0 { ringkasan = ringkasan + ", "; }
            ringkasan = ringkasan + p2["nama"] + " x" + keTeks(qty);
        }
    }
    biar pembeli: teks = penggunaKini();
    pesananBuat(pembeli, ringkasan, keTeks(total));

    mail_kirim_html("127.0.0.1", 1025, "", "", "toko@tenun.id", "pembeli@contoh.id",
        "Pesanan diterima",
        "<h2>Terima kasih, " + pembeli + "!</h2><p>" + ringkasan + "</p><p>Total: " + rupiah(keTeks(total)) + "</p>");

    hapus(keranjangKunci());
    flashSet("Pesanan berhasil! Konfirmasi dikirim via email.");
    kembali web_redirect("/pesanan");
}
