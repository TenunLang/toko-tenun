// Controller Pesanan — riwayat pesanan pengguna.

fungsi cRiwayat(): teks {
    biar daftar: []peta = pesananMilik(penggunaKini());
    biar baris: teks = "";
    untuk i dari 0 sampai panjang(daftar) {
        biar o: peta = daftar[i];
        baris = baris + "<tr><td>#" + o["id"] + "</td><td>" + esc(o["ringkasan"]) + "</td><td>" + rupiah(o["total"]) + "</td><td>" + o["dibuat_pada"] + "</td></tr>";
    }
    kalau panjangTeks(baris) == 0 {
        baris = "<tr><td colspan=\"4\">Belum ada pesanan.</td></tr>";
    }
    kembali render("Pesanan Saya", tampil("riwayat.batik", peta{ "baris": baris }));
}
