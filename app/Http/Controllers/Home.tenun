
fungsi _kartu(p: peta): teks {
    kembali "<div class=\"col-6 col-md-4 col-lg-3 mb-3\">" +
        "<div class=\"card product-card h-100\">" +
        "<a href=\"/produk/" + p["id"] + "\" class=\"pc-img d-block\">" +
        "<img src=\"" + p["gambar"] + "\" alt=\"" + p["nama"] + "\" loading=\"lazy\" referrerpolicy=\"no-referrer\">" +
        "<span class=\"pc-fav\"><i class=\"bi bi-heart\"></i></span></a>" +
        "<div class=\"card-body p-2 d-flex flex-column\">" +
        "<a href=\"/produk/" + p["id"] + "\" class=\"pc-title text-dark\">" + p["nama"] + "</a>" +
        "<div class=\"pc-price mt-1\">" + rupiah(keBulat(p["harga"])) + "</div>" +
        "<div class=\"pc-meta mt-auto pt-1\"><span class=\"pc-star\"><i class=\"bi bi-star-fill\"></i></span> 5.0 · " + p["terjual"] + " terjual</div>" +
        "</div></div></div>";
}

fungsi home_index(): teks {
    biar kat: teks = web_kueri("kategori");
    biar kunci: teks = web_kueri("cari");
    biar hasil: teks = orm_model_semua(DB, model_produk());
    biar n: bulat = orm_baris(hasil);
    biar html: teks = "";
    untuk i dari 0 sampai n {
        biar p: peta = orm_baris_peta(model_produk(), hasil, i);
        biar tampil: bool = benar;
        kalau panjangTeks(kat) > 0 { kalau p["kategori"] != kat { tampil = salah; } }
        kalau panjangTeks(kunci) > 0 { kalau cari(p["nama"], kunci) < 0 { tampil = salah; } }
        kalau tampil { html = html + _kartu(p); }
    }
    kalau panjangTeks(html) == 0 {
        html = "<div class=\"col-12 text-center text-muted py-5\">Produk tidak ditemukan.</div>";
    }
    biar data: peta = peta{};
    data["produk_html"] = html;
    data["kategori"] = kat;
    data["kunci"] = kunci;
    kembali sajikan("home/index", "Beranda", data);
}

fungsi produk_detail(): teks {
    biar id: teks = jala_param("id");
    biar p: peta = orm_model_cari_satu(DB, model_produk(), "id", id);
    kalau petaPunya(p, "id") == salah {
        jala_status(404);
        kembali sajikan("home/notfound", "Tidak Ditemukan", peta{});
    }
    biar gal: []teks = pisah(p["galeri"], ",");
    biar thumbs: teks = "";
    biar batas: bulat = panjang(gal);
    biar tampilkan: bulat = batas;
    kalau tampilkan > 5 { tampilkan = 5; }
    untuk i dari 0 sampai tampilkan {
        biar aktif: teks = "";
        kalau i == 0 { aktif = " active"; }
        kalau i == 4 {
            kalau batas > 5 {
                thumbs = thumbs + "<div class=\"pd-more\">+" + keTeks(batas - 4) + "</div>";
            } lain {
                thumbs = thumbs + "<img src=\"" + gal[i] + "\" class=\"pd-thumb" + aktif + "\" referrerpolicy=\"no-referrer\" onclick=\"gantiGambar(this)\">";
            }
        } lain {
            thumbs = thumbs + "<img src=\"" + gal[i] + "\" class=\"pd-thumb" + aktif + "\" referrerpolicy=\"no-referrer\" onclick=\"gantiGambar(this)\">";
        }
    }
    biar data: peta = peta{};
    data["id"] = p["id"];
    data["nama"] = p["nama"];
    data["kategori"] = p["kategori"];
    data["harga"] = rupiah(keBulat(p["harga"]));
    data["stok"] = p["stok"];
    data["terjual"] = p["terjual"];
    data["sku"] = p["sku"];
    data["gambar"] = gal[0];
    data["thumbs"] = thumbs;
    data["deskripsi"] = p["deskripsi"];
    kembali sajikan("home/detail", p["nama"], data);
}
