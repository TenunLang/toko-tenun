// Model Pesanan.

fungsi modelPesanan(): peta {
    biar m: peta = orm_model("pesanan");
    m = orm_kolom(m, "id", "SERIAL PRIMARY KEY");
    m = orm_kolom(m, "pembeli", "VARCHAR(100)");
    m = orm_kolom(m, "ringkasan", "TEXT");
    m = orm_kolom(m, "total", "INT");
    m = orm_kolom(m, "dibuat_pada", "TIMESTAMP DEFAULT CURRENT_TIMESTAMP");
    kembali m;
}

fungsi pesananBuat(pembeli: teks, ringkasan: teks, total: teks): kosong {
    biar d: bulat = db();
    orm_simpan(d, modelPesanan(), peta{ "pembeli": pembeli, "ringkasan": ringkasan, "total": total });
    orm_tutup(d);
}

// Riwayat pesanan milik seorang pembeli.
fungsi pesananMilik(pembeli: teks): []peta {
    biar d: bulat = db();
    biar hasil: teks = orm_model_cari(d, modelPesanan(), "pembeli", pembeli);
    biar n: bulat = orm_baris(hasil);
    biar m: peta = modelPesanan();
    biar daftar: []peta = [];
    untuk i dari 0 sampai n {
        daftar = dorong(daftar, orm_baris_peta(m, hasil, i));
    }
    orm_tutup(d);
    kembali daftar;
}
