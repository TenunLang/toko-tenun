// Model Pengguna — skema saja. peran: "admin" | "pelanggan".
fungsi model_pengguna(): peta {
    biar m: peta = orm_model("pengguna");
    m = orm_kolom(m, "id", orm_tipe_id());
    m = orm_kolom(m, "email", "VARCHAR(150)");
    m = orm_kolom(m, "nama", "VARCHAR(150)");
    m = orm_kolom(m, "sandi", "TEXT");
    m = orm_kolom(m, "peran", "VARCHAR(20)");
    kembali m;
}
