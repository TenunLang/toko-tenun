// Helper bersama (db() ada di driver/database.tenun).

fungsi rupiah(n: teks): teks {
    kembali "Rp " + n;
}

fungsi esc(s: teks): teks {
    kembali tampilan_escape(s);
}

// ---- Sesi ----
fungsi penggunaKini(): teks {
    biar sid: teks = sesi_dari_cookie();
    kalau panjangTeks(sid) == 0 {
        kembali "";
    }
    kembali sesi_field(sid, "nama");
}

// ---- Flash (KV per-sesi, sekali tampil) ----
fungsi flashSet(pesan: teks): kosong {
    biar sid: teks = sesi_dari_cookie();
    kalau panjangTeks(sid) > 0 {
        simpan("flash:" + sid, pesan);
    }
}

fungsi flashAmbil(): teks {
    biar sid: teks = sesi_dari_cookie();
    kalau panjangTeks(sid) == 0 {
        kembali "";
    }
    biar p: teks = muat("flash:" + sid);
    kalau panjangTeks(p) > 0 {
        hapus("flash:" + sid);
    }
    kembali p;
}

// ---- View ----
fungsi tampil(berkas: teks, data: peta): teks {
    kembali tampilan_render(bacaFile("resources/views/" + berkas), data);
}

// Layout + konten. pengguna & flash di-escape (anti XSS).
fungsi render(judul: teks, konten: teks): teks {
    kembali web_html(tampilan_render(bacaFile("resources/views/tata.batik"), peta{
        "judul": judul,
        "konten": konten,
        "pengguna": esc(penggunaKini()),
        "flash": esc(flashAmbil())
    }));
}
