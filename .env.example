# Konfigurasi Toko Tenun. Salin ke .env lalu sesuaikan.
# Dibaca otomatis oleh runtime Tenun via lingkungan("NAMA").
# Env proses asli (mis. systemd) menang atas nilai di sini.

# PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=toko_tenun

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Port HTTP aplikasi (dipakai juga oleh tenun-server via TENUN_PORT)
TENUN_PORT=8080
