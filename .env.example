# Konfigurasi Toko Tenun. Salin ke .env lalu sesuaikan.
# Dibaca config/env.tenun dengan prioritas: .env > env OS > default.
# JANGAN commit .env (berisi rahasia) — sudah di .gitignore.

# PostgreSQL
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=toko_tenun

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
# Isi bila Redis pakai requirepass:
REDIS_PASSWORD=
# Nomor DB Redis (opsional):
REDIS_DB=

# Server
TENUN_PORT=8080
TENUN_WORKERS=1
