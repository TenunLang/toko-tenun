// Titik masuk Toko Tenun & Batik. Jalankan: tenun
impor "jala";

impor "./App/Config.tenun";

impor "./App/Models/Produk.tenun";
impor "./App/Models/Keranjang.tenun";
impor "./App/Models/Pengguna.tenun";
impor "./App/Models/Pesanan.tenun";

impor "./App/Helper.tenun";

impor "./App/Controllers/Home.tenun";
impor "./App/Controllers/Produk.tenun";
impor "./App/Controllers/Keranjang.tenun";
impor "./App/Controllers/Checkout.tenun";
impor "./App/Controllers/Auth.tenun";
impor "./App/Controllers/Admin.tenun";

impor "./Routes.tenun";

// Data awal (idempoten): produk contoh + akun admin.
produk_seed();
pengguna_seed();

jala_statik("Public");

fungsi tangani(metode: teks, jalur: teks, badan: teks): teks {
    kembali jala_tangani(metode, jalur, badan);
}

cetak("Toko Tenun jalan di http://localhost:8080");
cetak("Admin: admin@toko.id / admin123");
jala_layani(8080);
