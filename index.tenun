// Toko Tenun — titik masuk. Jalankan: tenun
// Pastikan migrasi & seed sudah dijalankan:
//   tenun database/Migrasi.tenun
//   tenun database/Seeder.tenun
impor "jala";

impor "./config/app.tenun";
impor "./config/database.tenun";

impor "./app/Models/Produk.tenun";
impor "./app/Models/Pengguna.tenun";
impor "./app/Models/Pesanan.tenun";

impor "./app/Support/Helper.tenun";
impor "./app/Http/Middleware/Keamanan.tenun";
impor "./app/Services/Cart.tenun";

impor "./app/Http/Controllers/Home.tenun";
impor "./app/Http/Controllers/Keranjang.tenun";
impor "./app/Http/Controllers/Checkout.tenun";
impor "./app/Http/Controllers/Auth.tenun";
impor "./app/Http/Controllers/Admin.tenun";

impor "./routes/web.tenun";

jala_statik("public");

// Lapisan keamanan global (urut: header -> rate-limit -> CSRF).
jala_pakai(mw_keamanan);
jala_pakai(mw_batas_masuk);
jala_pakai(mw_csrf);

// Koneksi DB/Redis dibuka malas di worker (tiap proxy/worker punya soket sendiri).
fungsi tangani(metode: teks, jalur: teks, badan: teks): teks {
    kalau DB < 0 { db_init(); }
    kembali jala_tangani(metode, jalur, badan);
}

// Port dari env (.env / TENUN_PORT), fallback 8080.
biar port: bulat = keBulat(env_atau("TENUN_PORT", "8080"));
cetak("Toko Tenun jalan di http://localhost:" + keTeks(port));
jala_layani(port);
