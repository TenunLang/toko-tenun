// Driver cache — Redis. Aman bila Redis tidak ada (fungsi jadi no-op / "").
impor "redis";

fungsi cacheSet(kunci: teks, nilai: teks): kosong {
    biar s: bulat = redis_sambung("127.0.0.1", 6379);
    kalau s < 0 {
        kembali;
    }
    redis_jalan(s, ["SET", kunci, nilai]);
    redis_tutup(s);
}

fungsi cacheGet(kunci: teks): teks {
    biar s: bulat = redis_sambung("127.0.0.1", 6379);
    kalau s < 0 {
        kembali "";
    }
    biar v: teks = redis_jalan(s, ["GET", kunci]);
    redis_tutup(s);
    kembali v;
}

fungsi cacheHapus(kunci: teks): kosong {
    biar s: bulat = redis_sambung("127.0.0.1", 6379);
    kalau s < 0 {
        kembali;
    }
    redis_jalan(s, ["DEL", kunci]);
    redis_tutup(s);
}
