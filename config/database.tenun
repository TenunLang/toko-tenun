// Koneksi PostgreSQL (ORM) + Redis. Handle global dipakai seluruh app.
// Kredensial dari .env / env OS (modul dotenv), fallback default lokal.
impor "orm";
impor "redis";
impor "dotenv";

biar DB: bulat = 0 - 1;
biar RDS: bulat = 0 - 1;

fungsi db_init(): kosong {
    DB = orm_sambung("postgres",
        dotenv_ambil("PGHOST", "127.0.0.1"),
        keBulat(dotenv_ambil("PGPORT", "5432")),
        dotenv_ambil("PGUSER", "postgres"),
        dotenv_ambil("PGPASSWORD", "postgres"),
        dotenv_ambil("PGDATABASE", "toko_tenun"));

    RDS = redis_sambung(
        dotenv_ambil("REDIS_HOST", "127.0.0.1"),
        keBulat(dotenv_ambil("REDIS_PORT", "6379")));
    // AUTH bila REDIS_PASSWORD diset (Redis dengan requirepass).
    biar rpass: teks = dotenv_ambil("REDIS_PASSWORD", "");
    kalau panjangTeks(rpass) > 0 { redis_auth(RDS, rpass); }
    // Pilih nomor DB bila REDIS_DB diset.
    biar rdb: teks = dotenv_ambil("REDIS_DB", "");
    kalau panjangTeks(rdb) > 0 { redis_pilih(RDS, keBulat(rdb)); }
}
