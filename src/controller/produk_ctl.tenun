// Controller Produk — beranda, detail, API.

fungsi cBeranda(): teks {
    biar daftar: []peta = produkSemua();
    biar kartu: teks = "";
    untuk i dari 0 sampai panjang(daftar) {
        biar p: peta = daftar[i];
        kartu = kartu + tampil("kartu.batik", peta{
            "id": p["id"], "nama": p["nama"], "jenis": p["jenis"],
            "harga": rupiah(p["harga"]), "stok": p["stok"]
        });
    }
    kembali render("Beranda", tampil("beranda.batik", peta{ "produk": kartu }));
}

fungsi cDetailProduk(): teks {
    biar p: peta = produkCari(web_param("id"));
    kalau petaPunya(p, "id") == salah {
        web_status(404);
        kembali render("Tidak ditemukan", "<p>Produk tidak ada.</p>");
    }
    kembali render(p["nama"], tampil("produk.batik", peta{
        "id": p["id"], "nama": p["nama"], "jenis": p["jenis"],
        "harga": rupiah(p["harga"]), "stok": p["stok"], "deskripsi": p["deskripsi"]
    }));
}

fungsi cApiProduk(): teks {
    biar daftar: []peta = produkSemua();
    biar js: teks = "[";
    untuk i dari 0 sampai panjang(daftar) {
        biar p: peta = daftar[i];
        kalau i > 0 { js = js + ","; }
        js = js + "{\"id\":" + p["id"] + ",\"nama\":\"" + p["nama"] + "\",\"jenis\":\"" + p["jenis"] + "\",\"harga\":" + p["harga"] + ",\"stok\":" + p["stok"] + "}";
    }
    js = js + "]";
    kembali web_json(js);
}
