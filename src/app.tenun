// Toko Tenun & Batik — entry aplikasi (MVC).
// Model: src/model/*  Controller: src/controller/*  View: view/*.batik
// Jalankan: tenun run src/app.tenun   (butuh PostgreSQL di :5432, opsional Mailpit :1025)

// Modul pihak ketiga
impor "web";
impor "orm";
impor "tampilan";
impor "auth";
impor "sesi";
impor "mail";

// Lapisan aplikasi
impor "./config.tenun";
impor "./model/produk.tenun";
impor "./model/pengguna.tenun";
impor "./model/pesanan.tenun";
impor "./controller/produk_ctl.tenun";
impor "./controller/auth_ctl.tenun";
impor "./controller/keranjang_ctl.tenun";
impor "./controller/admin_ctl.tenun";

// Aset
fungsi cGaya(): teks {
    kembali web_berkas("publik/gaya.css");
}

// Rute (mengikat URL -> controller)
web_pakai(web_log);
web_statik("publik");
web_get("/", cBeranda);
web_get("/produk/:id", cDetailProduk);
web_get("/api/produk", cApiProduk);
web_get("/daftar", cFormDaftar);
web_post("/daftar", cProsesDaftar);
web_get("/masuk", cFormMasuk);
web_post("/masuk", cProsesMasuk);
web_get("/keluar", cKeluar);
web_get("/keranjang/tambah/:id", cTambahKeranjang);
web_get("/keranjang", cLihatKeranjang);
web_post("/checkout", cCheckout);
web_get("/admin", cFormAdmin);
web_post("/admin", cProsesAdmin);

// Migrasi + data contoh
fungsi siapkanDB(): kosong {
    kalau db() < 0 {
        cetak("[toko] GAGAL konek Postgres di 5432");
        kembali;
    }
    produkSiapkan();
    penggunaSiapkan();
    pesananSiapkan();
    cetak("[toko] database siap");
}
siapkanDB();

fungsi tangani(metode: teks, jalur: teks, badan: teks): teks {
    kembali web_tangani(metode, jalur, badan);
}
layani(8080);
