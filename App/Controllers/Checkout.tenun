// Controller Checkout.

fungsi checkout_form(): teks {
    biar sid: teks = sid_kini();
    kalau keranjang_jumlah(sid) == 0 {
        kembali jala_redirect("/keranjang");
    }
    biar data: peta = peta{};
    data["total"] = rupiah(keranjang_total(sid));
    data["email"] = user_kini();
    data["nama_user"] = pengguna_nama(user_kini());
    data["galat"] = jala_galat_pesan("nama") + jala_galat_pesan("alamat");
    kembali sajikan("Checkout/Index", "Checkout", data);
}

fungsi checkout_proses(): teks {
    biar sid: teks = sid_kini();
    kalau keranjang_jumlah(sid) == 0 {
        kembali jala_redirect("/keranjang");
    }
    kalau jala_perlu("nama") == salah { kembali checkout_form(); }
    kalau jala_perlu("alamat") == salah { kembali checkout_form(); }

    // rangkai items dari keranjang
    biar baris: []teks = keranjang_isi(sid);
    biar items: teks = "";
    untuk i dari 0 sampai panjang(baris) {
        biar f: []teks = pisah(baris[i], ":");
        kalau i > 0 { items = items + ";"; }
        items = items + f[0] + "#" + f[1];
    }

    biar kode: teks = pesanan_kode();
    biar email: teks = user_kini();
    kalau panjangTeks(email) == 0 { email = jala_input("email"); }
    pesanan_buat(kode, email, jala_input("nama"), jala_input("alamat"),
        keTeks(keranjang_total(sid)), items);
    keranjang_kosong(sid);
    kembali jala_redirect("/pesanan/" + kode);
}

fungsi pesanan_konfirmasi(): teks {
    biar kode: teks = jala_param("kode");
    biar baris: teks = pesanan_cari(kode);
    kalau panjangTeks(baris) == 0 {
        jala_status(404);
        kembali sajikan("Home/NotFound", "Tidak Ditemukan", peta{});
    }
    biar o: peta = pesanan_peta(baris);
    biar data: peta = peta{};
    data["kode"] = o["kode"];
    data["nama"] = o["nama"];
    data["alamat"] = o["alamat"];
    data["total"] = rupiah(keBulat(o["total"]));
    kembali sajikan("Checkout/Sukses", "Pesanan Berhasil", data);
}
