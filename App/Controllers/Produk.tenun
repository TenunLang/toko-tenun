// Controller Produk — halaman detail.

fungsi produk_detail(): teks {
    biar id: teks = jala_param("id");
    biar baris: teks = produk_cari(id);
    kalau panjangTeks(baris) == 0 {
        jala_status(404);
        kembali sajikan("Home/NotFound", "Tidak Ditemukan", peta{});
    }
    biar p: peta = produk_peta(baris);
    biar data: peta = peta{};
    data["id"] = p["id"];
    data["nama"] = p["nama"];
    data["kategori"] = p["kategori"];
    data["harga"] = rupiah(keBulat(p["harga"]));
    data["stok"] = p["stok"];
    data["gambar"] = p["gambar"];
    data["deskripsi"] = p["deskripsi"];
    kembali sajikan("Home/Detail", p["nama"], data);
}
