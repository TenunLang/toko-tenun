// Controller Home — katalog produk + filter kategori.

fungsi _kartu(p: peta): teks {
    kembali "<div class=\"col-6 col-md-3 mb-4\">" +
        "<div class=\"card h-100 shadow-sm border-0 produk-card\">" +
        "<a href=\"/produk/" + p["id"] + "\"><img src=\"" + p["gambar"] + "\" class=\"card-img-top\" alt=\"" + p["nama"] + "\" loading=\"lazy\"></a>" +
        "<div class=\"card-body d-flex flex-column\">" +
        "<span class=\"badge bg-light text-dark align-self-start mb-1\">" + p["kategori"] + "</span>" +
        "<h6 class=\"card-title\"><a href=\"/produk/" + p["id"] + "\" class=\"text-decoration-none text-dark\">" + p["nama"] + "</a></h6>" +
        "<div class=\"mt-auto\">" +
        "<div class=\"fw-bold text-success mb-2\">" + rupiah(keBulat(p["harga"])) + "</div>" +
        "<form method=\"post\" action=\"/keranjang/tambah/" + p["id"] + "\">" +
        "<button class=\"btn btn-sm btn-warning w-100\"><i class=\"bi bi-cart-plus\"></i> Keranjang</button>" +
        "</form></div></div></div></div>";
}

fungsi home_index(): teks {
    biar kat: teks = web_kueri("kategori");
    biar kunci: teks = web_kueri("cari");
    biar baris: []teks = produk_semua();
    biar html: teks = "";
    untuk i dari 0 sampai panjang(baris) {
        biar p: peta = produk_peta(baris[i]);
        biar cocok_kat: bool = benar;
        kalau panjangTeks(kat) > 0 { kalau p["kategori"] != kat { cocok_kat = salah; } }
        biar cocok_cari: bool = benar;
        kalau panjangTeks(kunci) > 0 { kalau cari(p["nama"], kunci) < 0 { cocok_cari = salah; } }
        kalau cocok_kat {
            kalau cocok_cari { html = html + _kartu(p); }
        }
    }
    kalau panjangTeks(html) == 0 {
        html = "<div class=\"col-12 text-center text-muted py-5\">Produk tidak ditemukan.</div>";
    }
    biar data: peta = peta{};
    data["produk_html"] = html;
    data["kategori"] = kat;
    kembali sajikan("Home/Index", "Beranda", data);
}
