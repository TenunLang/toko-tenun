// Controller Admin — dashboard, kelola produk (DataTables), pesanan, livechat.
// Semua aksi dijaga is_admin().

fungsi _jaga(): bool {
    kalau is_admin() { kembali benar; }
    kembali salah;
}

fungsi admin_dashboard(): teks {
    kalau _jaga() == salah { kembali jala_redirect("/masuk"); }
    biar omzet: bulat = 0;
    biar pes: []teks = pesanan_semua();
    untuk i dari 0 sampai panjang(pes) {
        omzet = omzet + keBulat(pisah(pes[i], "|")[4]);
    }
    biar data: peta = peta{};
    data["jum_produk"] = keTeks(panjang(produk_semua()));
    data["jum_pesanan"] = keTeks(panjang(pes));
    data["omzet"] = rupiah(omzet);
    kembali sajikan("Admin/Dashboard", "Dashboard Admin", data);
}

fungsi admin_produk(): teks {
    kalau _jaga() == salah { kembali jala_redirect("/masuk"); }
    kembali sajikan("Admin/Produk", "Kelola Produk", peta{});
}

fungsi admin_produk_simpan(): teks {
    kalau _jaga() == salah { kembali jala_redirect("/masuk"); }
    produk_tambah(jala_input("nama"), jala_input("kategori"), jala_input("harga"),
        jala_input("stok"), jala_input("gambar"), jala_input("deskripsi"));
    kembali jala_redirect("/admin/produk");
}

fungsi admin_produk_hapus(): teks {
    kalau _jaga() == salah { kembali jala_redirect("/masuk"); }
    produk_hapus(jala_param("id"));
    kembali jala_redirect("/admin/produk");
}

fungsi admin_pesanan(): teks {
    kalau _jaga() == salah { kembali jala_redirect("/masuk"); }
    kembali sajikan("Admin/Pesanan", "Kelola Pesanan", peta{});
}

fungsi admin_chat(): teks {
    kalau _jaga() == salah { kembali jala_redirect("/masuk"); }
    kembali sajikan("Admin/Chat", "Live Chat", peta{});
}

// ---- API JSON untuk DataTables (client-side) ----

fungsi _js(s: teks): teks {
    biar r: teks = ganti(s, "\\", "\\\\");
    r = ganti(r, "\"", "\\\"");
    kembali r;
}

fungsi api_produk(): teks {
    kalau _jaga() == salah { jala_status(403); kembali jala_json("{\"data\":[]}"); }
    biar baris: []teks = produk_semua();
    biar arr: teks = "";
    untuk i dari 0 sampai panjang(baris) {
        biar p: peta = produk_peta(baris[i]);
        kalau i > 0 { arr = arr + ","; }
        arr = arr + "[\"" + p["id"] + "\",\"" + _js(p["nama"]) + "\",\"" + p["kategori"] +
            "\",\"" + rupiah(keBulat(p["harga"])) + "\",\"" + p["stok"] +
            "\",\"<a href='/admin/produk/hapus/" + p["id"] + "' class='btn btn-sm btn-outline-danger'>Hapus</a>\"]";
    }
    kembali jala_json("{\"data\":[" + arr + "]}");
}

fungsi api_pesanan(): teks {
    kalau _jaga() == salah { jala_status(403); kembali jala_json("{\"data\":[]}"); }
    biar baris: []teks = pesanan_semua();
    biar arr: teks = "";
    untuk i dari 0 sampai panjang(baris) {
        biar o: peta = pesanan_peta(baris[i]);
        kalau i > 0 { arr = arr + ","; }
        arr = arr + "[\"" + o["kode"] + "\",\"" + _js(o["nama"]) + "\",\"" + _js(o["email"]) +
            "\",\"" + rupiah(keBulat(o["total"])) + "\",\"" + o["status"] + "\"]";
    }
    kembali jala_json("{\"data\":[" + arr + "]}");
}
