// Model Produk — repository kunci-nilai (swappable ke Redis/ORM untuk skala besar).
// Record disimpan satu baris per produk: id|nama|kategori|harga|stok|gambar|deskripsi
// Daftar disimpan di kunci "produk:db" (dipisah newline).

fungsi _produk_seed_data(): teks {
    kembali "1|Kain Batik Tulis Parang|Batik|285000|12|https://loremflickr.com/600/400/batik/all?lock=1|Batik tulis motif Parang klasik, pewarna alami, kain katun primisima.\n" +
        "2|Batik Cap Mega Mendung|Batik|175000|20|https://loremflickr.com/600/400/batik,cloud/all?lock=2|Motif Mega Mendung khas Cirebon, warna gradasi biru.\n" +
        "3|Tenun Ikat Sumba|Tenun|450000|8|https://loremflickr.com/600/400/woven,textile/all?lock=3|Tenun ikat tangan asli Sumba, pewarna alam, eksklusif.\n" +
        "4|Tenun Songket Palembang|Tenun|620000|5|https://loremflickr.com/600/400/songket,gold/all?lock=4|Songket benang emas, motif pucuk rebung mewah.\n" +
        "5|Kemeja Batik Pria Slimfit|Pakaian|220000|30|https://loremflickr.com/600/400/batik,shirt/all?lock=5|Kemeja batik modern slimfit, adem, cocok kerja & acara.\n" +
        "6|Dress Batik Wanita|Pakaian|265000|18|https://loremflickr.com/600/400/batik,dress/all?lock=6|Dress batik kontemporer, potongan A-line, elegan.\n" +
        "7|Selendang Tenun Lombok|Tenun|135000|25|https://loremflickr.com/600/400/scarf,weave/all?lock=7|Selendang tenun Lombok, lembut, motif geometris.\n" +
        "8|Batik Sutra Premium|Batik|780000|4|https://loremflickr.com/600/400/silk,batik/all?lock=8|Batik di atas kain sutra murni, halus dan berkilau.";
}

fungsi produk_seed(): kosong {
    kalau panjangTeks(muat("produk:db")) == 0 {
        simpan("produk:db", _produk_seed_data());
    }
}

fungsi produk_semua(): []teks {
    biar d: teks = muat("produk:db");
    kalau panjangTeks(d) == 0 { kembali []; }
    kembali pisah(d, "\n");
}

// Cari baris produk berdasar id ("" bila tak ada).
fungsi produk_cari(id: teks): teks {
    biar baris: []teks = produk_semua();
    untuk i dari 0 sampai panjang(baris) {
        biar f: []teks = pisah(baris[i], "|");
        kalau f[0] == id { kembali baris[i]; }
    }
    kembali "";
}

// Ubah baris produk -> peta untuk view.
fungsi produk_peta(baris: teks): peta {
    biar f: []teks = pisah(baris, "|");
    biar p: peta = peta{};
    p["id"] = f[0];
    p["nama"] = f[1];
    p["kategori"] = f[2];
    p["harga"] = f[3];
    p["stok"] = f[4];
    p["gambar"] = f[5];
    p["deskripsi"] = f[6];
    kembali p;
}

// Tambah produk baru (admin). id otomatis = maks+1.
fungsi produk_tambah(nama: teks, kategori: teks, harga: teks, stok: teks, gambar: teks, deskripsi: teks): kosong {
    biar baris: []teks = produk_semua();
    biar maks: bulat = 0;
    untuk i dari 0 sampai panjang(baris) {
        biar f: []teks = pisah(baris[i], "|");
        biar idn: bulat = keBulat(f[0]);
        kalau idn > maks { maks = idn; }
    }
    biar id: bulat = maks + 1;
    biar rec: teks = keTeks(id) + "|" + nama + "|" + kategori + "|" + harga + "|" + stok + "|" + gambar + "|" + deskripsi;
    biar d: teks = muat("produk:db");
    kalau panjangTeks(d) == 0 { simpan("produk:db", rec); }
    lain { simpan("produk:db", d + "\n" + rec); }
}

fungsi produk_hapus(id: teks): kosong {
    biar baris: []teks = produk_semua();
    biar keluar: teks = "";
    biar pertama: bool = benar;
    untuk i dari 0 sampai panjang(baris) {
        biar f: []teks = pisah(baris[i], "|");
        kalau f[0] != id {
            kalau pertama { keluar = baris[i]; pertama = salah; }
            lain { keluar = keluar + "\n" + baris[i]; }
        }
    }
    simpan("produk:db", keluar);
}
