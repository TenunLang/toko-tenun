// Model Pesanan — skema saja. items: "produkid#qty;produkid#qty".
fungsi model_pesanan(): peta {
    biar m: peta = orm_model("pesanan");
    m = orm_kolom(m, "id", orm_tipe_id());
    m = orm_kolom(m, "kode", "VARCHAR(40)");
    m = orm_kolom(m, "email", "VARCHAR(150)");
    m = orm_kolom(m, "nama", "VARCHAR(150)");
    m = orm_kolom(m, "alamat", "TEXT");
    m = orm_kolom(m, "total", "BIGINT");
    m = orm_kolom(m, "items", "TEXT");
    m = orm_kolom(m, "status", "VARCHAR(20)");
    m = orm_kolom(m, "dibuat", "BIGINT");
    kembali m;
}
