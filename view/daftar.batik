<div class="form-kotak">
  <h1>Daftar</h1>
  <form method="post" action="/daftar">
    <label>Nama<input type="text" name="nama" required></label>
    <label>Email<input type="email" name="email" required></label>
    <label>Sandi<input type="password" name="sandi" required></label>
    <button class="tombol" type="submit">Buat Akun</button>
  </form>
  <p>Sudah punya akun? <a href="/masuk">Masuk</a></p>
</div>
