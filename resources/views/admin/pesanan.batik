<h3 class="fw-bold mb-3"><i class="bi bi-receipt"></i> Kelola Pesanan</h3>
<div class="card card-body shadow-sm border-0">
  <table id="tbl-pesanan" class="table table-striped w-100">
    <thead><tr><th>Kode</th><th>Nama</th><th>Email</th><th>Total</th><th>Status</th></tr></thead>
  </table>
</div>
<script>
$(function(){ $('#tbl-pesanan').DataTable({ ajax:'/api/pesanan', order:[[0,'desc']], language:{ url:'https://cdn.datatables.net/plug-ins/1.13.8/i18n/id.json' } }); });
</script>
