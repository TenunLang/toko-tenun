<h3 class="fw-bold mb-3"><i class="bi bi-headset"></i> Live Chat — Admin</h3>
<div class="card shadow-sm border-0" style="max-width:720px">
  <div id="admin-msgs" class="card-body" style="height:55vh;overflow-y:auto;background:#faf7f4"></div>
  <div class="card-footer p-2">
    <div class="input-group">
      <input id="admin-input" class="form-control" placeholder="Balas pelanggan...">
      <button id="admin-send" class="btn btn-warning">Kirim</button>
    </div>
  </div>
</div>
<script>
(function(){
  var box=document.getElementById('admin-msgs');
  var input=document.getElementById('admin-input');
  function add(text,me){
    var d=document.createElement('div'); d.className='mb-1'+(me?' text-end':'');
    var b=document.createElement('span'); b.className='badge '+(me?'bg-warning text-dark':'bg-secondary'); b.textContent=me?'admin':'pelanggan';
    d.appendChild(b); d.appendChild(document.createTextNode(' ')); var t=document.createElement('span'); t.textContent=text; d.appendChild(t);
    box.appendChild(d); box.scrollTop=box.scrollHeight;
  }
  var ws=new WebSocket(window.WS_URL);
  ws.onmessage=function(e){ var t=e.data, me=t.indexOf('Admin:')===0; add(me?t.slice(6).trim():t, me); };
  function send(){ var v=input.value.trim(); if(!v||ws.readyState!==1)return; ws.send('Admin: '+v); input.value=''; }
  document.getElementById('admin-send').onclick=send;
  input.addEventListener('keydown',function(e){if(e.key=='Enter')send();});
})();
</script>
