<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="fw-bold mb-0"><i class="bi bi-box-seam"></i> Kelola Produk</h3>
  <button class="btn btn-warning" data-bs-toggle="collapse" data-bs-target="#form-produk"><i class="bi bi-plus-lg"></i> Tambah Produk</button>
</div>
<div class="collapse mb-4" id="form-produk">
  <div class="card card-body shadow-sm border-0">
    <form method="post" action="/admin/produk" class="row g-2">
      <div class="col-md-4"><input name="nama" class="form-control" placeholder="Nama produk" required></div>
      <div class="col-md-2"><select name="kategori" class="form-select"><option>Kemeja</option><option>Dress</option><option>Blouse</option><option>Outer</option><option>Anak</option><option>Bahan</option></select></div>
      <div class="col-md-2"><input name="harga" type="number" class="form-control" placeholder="Harga" required></div>
      <div class="col-md-2"><input name="stok" type="number" class="form-control" placeholder="Stok" required></div>
      <div class="col-md-6"><input name="gambar" class="form-control" placeholder="URL gambar"></div>
      <div class="col-md-6"><input name="deskripsi" class="form-control" placeholder="Deskripsi"></div>
      <div class="col-12"><button class="btn btn-success">Simpan</button></div>
    </form>
  </div>
</div>
<div class="card card-body shadow-sm border-0">
  <table id="tbl-produk" class="table table-striped w-100">
    <thead><tr><th>ID</th><th>Nama</th><th>Kategori</th><th>Harga</th><th>Stok</th><th>Aksi</th></tr></thead>
  </table>
</div>
<script>
$(function(){ $('#tbl-produk').DataTable({ ajax:'/api/produk', language:{ url:'https://cdn.datatables.net/plug-ins/1.13.8/i18n/id.json' } }); });
</script>
