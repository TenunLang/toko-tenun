<h3 class="fw-bold mb-3"><i class="bi bi-cart3"></i> Keranjang Belanja</h3>
{{#jika kosong}}
<div class="text-center py-5">
  <i class="bi bi-cart-x" style="font-size:4rem;color:#bbb"></i>
  <p class="text-muted mt-3">Keranjang masih kosong.</p>
  <a href="/" class="btn btn-warning">Mulai Belanja</a>
</div>
{{/jika kosong}}
{{#kecuali kosong}}
<div class="table-responsive">
  <table class="table align-middle">
    <thead><tr><th>Produk</th><th>Harga</th><th>Qty</th><th>Subtotal</th><th></th></tr></thead>
    <tbody>{{rows}}</tbody>
  </table>
</div>
<div class="d-flex justify-content-end align-items-center gap-3">
  <div class="fs-5">Total: <strong class="text-success">{{total}}</strong></div>
  <a href="/checkout" class="btn btn-success btn-lg"><i class="bi bi-bag-check"></i> Checkout</a>
</div>
{{/kecuali kosong}}
