<div class="row justify-content-center">
  <div class="col-md-5">
    <div class="card shadow-sm border-0"><div class="card-body p-4">
      <h4 class="fw-bold mb-3 text-center"><i class="bi bi-box-arrow-in-right"></i> Masuk</h4>
      {{#jika galat}}<div class="alert alert-danger py-2">{{galat}}</div>{{/jika galat}}
      <form method="post" action="/masuk">
        <div class="mb-3"><label class="form-label">Email</label><input name="email" type="email" class="form-control" required></div>
        <div class="mb-3"><label class="form-label">Sandi</label><input name="sandi" type="password" class="form-control" required></div>
        <button class="btn btn-warning w-100">Masuk</button>
      </form>
      <p class="text-center small mt-3 mb-0">Belum punya akun? <a href="/daftar">Daftar</a></p>
      <p class="text-center small text-muted mt-2 mb-0">Demo admin: admin@toko.id / admin123</p>
    </div></div>
  </div>
</div>
