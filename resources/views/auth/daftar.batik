<div class="row justify-content-center">
  <div class="col-md-5">
    <div class="card shadow-sm border-0"><div class="card-body p-4">
      <h4 class="fw-bold mb-3 text-center"><i class="bi bi-person-plus"></i> Daftar Akun</h4>
      {{#jika galat}}<div class="alert alert-danger py-2">{{galat}}</div>{{/jika galat}}
      <form method="post" action="/daftar">{{csrf}}
        <div class="mb-3"><label class="form-label">Nama</label><input name="nama" class="form-control" required></div>
        <div class="mb-3"><label class="form-label">Email</label><input name="email" type="email" class="form-control" required></div>
        <div class="mb-3"><label class="form-label">Sandi (min 6)</label><input name="sandi" type="password" class="form-control" required></div>
        <button class="btn btn-warning w-100">Daftar</button>
      </form>
      <p class="text-center small mt-3 mb-0">Sudah punya akun? <a href="/masuk">Masuk</a></p>
    </div></div>
  </div>
</div>
