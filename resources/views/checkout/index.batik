<h3 class="fw-bold mb-3"><i class="bi bi-bag-check"></i> Checkout</h3>
<div class="row g-4">
  <div class="col-md-7">
    {{#jika galat}}<div class="alert alert-danger">{{galat}}</div>{{/jika galat}}
    <form method="post" action="/checkout" class="card card-body shadow-sm border-0">
      <div class="mb-3"><label class="form-label">Nama Penerima</label><input name="nama" class="form-control" value="{{nama_user}}" required></div>
      <div class="mb-3"><label class="form-label">Email</label><input name="email" type="email" class="form-control" value="{{email}}"></div>
      <div class="mb-3"><label class="form-label">Alamat Pengiriman</label><textarea name="alamat" class="form-control" rows="3" required></textarea></div>
      <button class="btn btn-success btn-lg"><i class="bi bi-check2-circle"></i> Buat Pesanan</button>
    </form>
  </div>
  <div class="col-md-5">
    <div class="card card-body shadow-sm border-0">
      <h6 class="fw-bold">Ringkasan</h6>
      <div class="d-flex justify-content-between"><span>Total</span><strong class="text-success">{{total}}</strong></div>
      <small class="text-muted mt-2">Pembayaran via transfer (simulasi).</small>
    </div>
  </div>
</div>
