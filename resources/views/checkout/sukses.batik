<div class="text-center py-5">
  <i class="bi bi-check-circle-fill text-success" style="font-size:5rem"></i>
  <h2 class="mt-3 fw-bold">Pesanan Berhasil!</h2>
  <p class="text-muted">Terima kasih, {{nama}}. Pesanan kamu sedang diproses.</p>
  <div class="card card-body shadow-sm border-0 mx-auto mt-3" style="max-width:420px">
    <div class="d-flex justify-content-between"><span>Kode</span><strong>{{kode}}</strong></div>
    <div class="d-flex justify-content-between"><span>Total</span><strong class="text-success">{{total}}</strong></div>
    <div class="d-flex justify-content-between"><span>Alamat</span><span class="text-end">{{alamat}}</span></div>
  </div>
  <a href="/" class="btn btn-warning mt-4">Belanja Lagi</a>
</div>
