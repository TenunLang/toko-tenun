<h1>Keranjang</h1>
<table class="tabel">
  <thead><tr><th>Produk</th><th>Harga</th><th>Jumlah</th><th>Subtotal</th><th></th></tr></thead>
  <tbody>
    {{baris}}
  </tbody>
  <tfoot><tr><th colspan="3">Total</th><th colspan="2">{{total}}</th></tr></tfoot>
</table>
<form method="post" action="/checkout">
  <button class="tombol besar" type="submit">Checkout</button>
</form>
