<nav class="navbar navbar-expand-lg app-header sticky-top shadow-sm">
  <div class="container">
    <a class="navbar-brand fw-bold" href="/"><i class="bi bi-bag-heart-fill"></i> {{nama_app}}</a>
    <button class="navbar-toggler text-white border-0" data-bs-toggle="collapse" data-bs-target="#nav"><i class="bi bi-list fs-3"></i></button>
    <div class="collapse navbar-collapse" id="nav">
      <form class="d-flex searchbar mx-lg-auto my-2 my-lg-0" action="/" method="get" style="max-width:460px;width:100%">
        <input class="form-control me-2" name="cari" placeholder="Cari batik, dress, kemeja...">
        <button class="btn btn-light" type="submit"><i class="bi bi-search text-merah"></i></button>
      </form>
      <ul class="navbar-nav ms-lg-3 align-items-lg-center">
        <li class="nav-item">
          <a class="nav-link position-relative" href="/keranjang"><i class="bi bi-cart3 fs-5"></i>
            {{#jika keranjang_jumlah}}<span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-dark">{{keranjang_jumlah}}</span>{{/jika keranjang_jumlah}}
          </a>
        </li>
        {{#jika masuk}}
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#"><i class="bi bi-person-circle"></i> {{user_nama}}</a>
          <ul class="dropdown-menu dropdown-menu-end">
            {{#jika admin}}<li><a class="dropdown-item" href="/admin"><i class="bi bi-speedometer2"></i> Dashboard</a></li>{{/jika admin}}
            <li><a class="dropdown-item" href="/keranjang">Keranjang</a></li>
            <li><a class="dropdown-item" href="/keluar">Keluar</a></li>
          </ul>
        </li>
        {{/jika masuk}}
        {{#kecuali masuk}}
        <li class="nav-item"><a class="nav-link" href="/masuk">Masuk</a></li>
        <li class="nav-item"><a class="btn btn-light btn-sm text-merah fw-semibold ms-lg-2" href="/daftar">Daftar</a></li>
        {{/kecuali masuk}}
      </ul>
    </div>
  </div>
</nav>
