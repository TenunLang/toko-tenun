    <button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button>
    <div class="collapse navbar-collapse" id="nav">
      <form class="d-flex mx-lg-auto my-2 my-lg-0" role="search" action="/" method="get" style="max-width:420px;width:100%">
        <input class="form-control me-2" name="cari" placeholder="Cari batik, tenun, songket...">
        <button class="btn btn-warning" type="submit"><i class="bi bi-search"></i></button>
      </form>
      <ul class="navbar-nav ms-lg-3 align-items-lg-center">
        <li class="nav-item"><a class="nav-link" href="/?kategori=Dress">Dress</a></li>
        <li class="nav-item"><a class="nav-link" href="/?kategori=Kemeja">Kemeja</a></li>
        <li class="nav-item"><a class="nav-link" href="/?kategori=Outer">Outer</a></li>
        <li class="nav-item">
          <a class="nav-link position-relative" href="/keranjang"><i class="bi bi-cart3 fs-5"></i>
