          </a>
        </li>
        {{#jika masuk}}
        <li class="nav-item dropdown">
          <a class="nav-link dropdown-toggle" data-bs-toggle="dropdown" href="#"><i class="bi bi-person-circle"></i> {{user_nama}}</a>
          <ul class="dropdown-menu dropdown-menu-end">
            {{#jika admin}}<li><a class="dropdown-item" href="/admin"><i class="bi bi-speedometer2"></i> Dashboard</a></li>{{/jika admin}}
