<nav aria-label="breadcrumb"><ol class="breadcrumb small">
  <li class="breadcrumb-item"><a href="/">Beranda</a></li>
  <li class="breadcrumb-item"><a href="/?kategori={{kategori}}">{{kategori}}</a></li>
  <li class="breadcrumb-item active">{{nama}}</li>
</ol></nav>

<div class="row g-4">
  <div class="col-md-5">
    <img id="pd-main" src="{{gambar}}" class="pd-main" alt="{{nama}}" referrerpolicy="no-referrer">
    <div class="pd-thumbs">{{thumbs}}</div>
  </div>
  <div class="col-md-7">
    <div class="d-flex justify-content-between align-items-start">
      <span class="badge bg-light text-dark border">{{kategori}}</span>
      <span class="pc-star"><i class="bi bi-star-fill"></i> 4.8</span>
    </div>
    <h4 class="fw-bold mt-2">{{nama}}</h4>
    <div class="text-muted small mb-2">{{terjual}} terjual · SKU {{sku}} · Stok {{stok}}</div>
    <div class="pd-price mb-3">{{harga}}</div>

    <div class="mb-3">
      <div class="fw-semibold mb-1">Pilih Ukuran</div>
      <span class="size-chip active">S</span><span class="size-chip">M</span><span class="size-chip">L</span><span class="size-chip">XL</span><span class="size-chip">XXL</span>
    </div>
    <div class="mb-3">
      <div class="fw-semibold mb-1">Pilih Warna</div>
      <span class="color-sw active" style="background:#7b4b2a"></span>
      <span class="color-sw" style="background:#c0392b"></span>
      <span class="color-sw" style="background:#2c3e50"></span>
      <span class="color-sw" style="background:#27ae60"></span>
      <span class="color-sw" style="background:#111"></span>
    </div>

    <div class="mb-3">
      <div class="fw-semibold mb-1">Detail Produk</div>
      <p class="text-muted small mb-0">{{deskripsi}}</p>
    </div>

    <div class="d-flex gap-3 small text-muted mb-3">
      <span><i class="bi bi-shield-check text-merah"></i> Original</span>
      <span><i class="bi bi-truck text-merah"></i> Gratis ongkir*</span>
      <span><i class="bi bi-arrow-repeat text-merah"></i> Garansi tukar</span>
    </div>

    <div class="buybar d-flex align-items-center justify-content-between">
      <div>
        <div class="text-muted small">Total Harga</div>
        <div class="pd-price" style="font-size:1.3rem">{{harga}}</div>
      </div>
      <form method="post" action="/keranjang/tambah/{{id}}" class="d-flex gap-2 m-0">{{csrf}}
        <button class="btn btn-outline-danger rounded-pill px-3"><i class="bi bi-cart-plus"></i></button>
        <a href="/checkout" class="btn btn-merah px-4"><i class="bi bi-bag-check"></i> Tambah ke Keranjang</a>
      </form>
    </div>
  </div>
</div>
