<nav aria-label="breadcrumb"><ol class="breadcrumb">
  <li class="breadcrumb-item"><a href="/">Beranda</a></li>
  <li class="breadcrumb-item"><a href="/?kategori={{kategori}}">{{kategori}}</a></li>
  <li class="breadcrumb-item active">{{nama}}</li>
</ol></nav>
<div class="row g-4">
  <div class="col-md-6"><img src="{{gambar}}" class="img-fluid rounded shadow-sm w-100" alt="{{nama}}"></div>
  <div class="col-md-6">
    <span class="badge bg-secondary mb-2">{{kategori}}</span>
    <h2 class="fw-bold">{{nama}}</h2>
    <div class="fs-3 text-success fw-bold mb-3">{{harga}}</div>
    <p class="text-muted">{{deskripsi}}</p>
    <p><i class="bi bi-box-seam"></i> Stok: <strong>{{stok}}</strong></p>
    <form method="post" action="/keranjang/tambah/{{id}}">
      <button class="btn btn-warning btn-lg"><i class="bi bi-cart-plus"></i> Tambah ke Keranjang</button>
      <a href="/checkout" class="btn btn-success btn-lg">Beli Sekarang</a>
    </form>
  </div>
</div>
