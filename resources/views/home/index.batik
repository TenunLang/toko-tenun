<div class="offer p-4 mb-4">
  <span class="badge bg-dark mb-2">Penawaran Terbatas!</span>
  <div class="h5 mb-0 fw-semibold">Diskon Spesial Untukmu</div>
  <div class="big my-1">40% OFF</div>
  <small class="text-white-50">Berlaku untuk koleksi tenun pilihan</small>
  <div class="mt-3"><a href="/?kategori=Dress" class="claim">Klaim Sekarang</a></div>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
  <h6 class="sec-title mb-0">Kategori</h6>
  <a href="/" class="see-all">Lihat Semua</a>
</div>
<div class="kat-row mb-4">
  <a class="kat-item" href="/?kategori=Dress"><div class="kat-ic"><i class="bi bi-bag-heart"></i></div><div class="lbl">Dress</div></a>
  <a class="kat-item" href="/?kategori=Kemeja"><div class="kat-ic"><i class="bi bi-person-vcard"></i></div><div class="lbl">Kemeja</div></a>
  <a class="kat-item" href="/?kategori=Outer"><div class="kat-ic"><i class="bi bi-layers"></i></div><div class="lbl">Outer</div></a>
  <a class="kat-item" href="/?kategori=Blouse"><div class="kat-ic"><i class="bi bi-flower1"></i></div><div class="lbl">Blouse</div></a>
  <a class="kat-item" href="/?kategori=Anak"><div class="kat-ic"><i class="bi bi-emoji-smile"></i></div><div class="lbl">Anak</div></a>
  <a class="kat-item" href="/?kategori=Bahan"><div class="kat-ic"><i class="bi bi-scissors"></i></div><div class="lbl">Bahan</div></a>
</div>

<div class="d-flex justify-content-between align-items-center mb-2">
  <h6 class="sec-title mb-0">{{#jika kategori}}{{kategori}}{{/jika kategori}}{{#kecuali kategori}}Flash Sale{{/kecuali kategori}}</h6>
  {{#jika kunci}}<span class="text-muted small">pencarian: "{{kunci}}"</span>{{/jika kunci}}
</div>
<div class="fs-tabs mb-3">
  <a href="/" class="{{#kecuali kategori}}active{{/kecuali kategori}}">Semua</a>
  <a href="/?kategori=Dress">Dress</a>
  <a href="/?kategori=Kemeja">Kemeja</a>
  <a href="/?kategori=Outer">Outer</a>
  <a href="/?kategori=Anak">Anak</a>
  <a href="/?kategori=Bahan">Bahan</a>
</div>

<div class="row g-2 g-md-3">
{{produk_html}}
</div>
