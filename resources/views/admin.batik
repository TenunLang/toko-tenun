<div class="form-kotak lebar">
  <h1>Tambah Produk</h1>
  <form method="post" action="/admin">
    <label>Nama<input type="text" name="nama" required></label>
    <label>Jenis
      <select name="jenis">
        <option value="tenun">Tenun</option>
        <option value="batik">Batik</option>
      </select>
    </label>
    <label>Harga (Rp)<input type="number" name="harga" required></label>
    <label>Stok<input type="number" name="stok" required></label>
    <label>Deskripsi<textarea name="deskripsi" rows="3"></textarea></label>
    <button class="tombol" type="submit">Simpan</button>
  </form>
</div>
