<article class="detail">
  <div class="gbr-besar {{jenis}}">{{jenis}}</div>
  <div class="info">
    <a href="/" class="balik">&larr; Semua produk</a>
    <h1>{{nama}}</h1>
    <span class="badge">{{jenis}}</span>
    <p class="harga-besar">{{harga}}</p>
    <p class="stok">Stok tersedia: {{stok}}</p>
    <p class="deskripsi">{{deskripsi}}</p>
    <a class="tombol besar" href="/keranjang/tambah/{{id}}">Tambah ke Keranjang</a>
  </div>
</article>
