// Server Live Chat — WebSocket mentah, broadcast semua pesan ke semua klien.
// Jalankan TERPISAH dari web: tenun chat.tenun  (port 3000)
//
// Skala: untuk banyak instance, ganti ws_siar dengan publish ke Redis channel
// lalu tiap instance subscribe & broadcast lokal (fan-out). Lihat README.
impor "websocket";

fungsi koneksi(soket: bulat): kosong {
    kalau ws_terima_handshake(soket) == salah {
        kembali;
    }
    selama benar {
        biar m: teks = ws_baca(soket);
        kalau panjangTeks(m) == 0 {
            kembali;
        }
        ws_siar(m);
    }
}

cetak("Live chat WS di ws://localhost:3000");
layaniSoket(3000);
