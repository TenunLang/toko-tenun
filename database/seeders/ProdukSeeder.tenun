// Seeder produk — baca hasil scrape (database/seeders/produk.csv).
// Format baris: nama|kategori|harga|stok|gambar|galeri|sku|terjual|deskripsi
// Hasilkan dulu: tenun tools/scrape.tenun
fungsi seed_produk(): kosong {
    kalau orm_model_hitung(DB, model_produk()) > 0 {
        cetak("  [seed] produk sudah ada, lewati");
        kembali;
    }
    biar isi: teks = bacaFile("database/seeders/produk.csv");
    kalau panjangTeks(isi) == 0 {
        cetak("  [seed] produk.csv kosong — jalankan: tenun tools/scrape.tenun");
        kembali;
    }
    biar baris: []teks = pisah(isi, "\n");
    biar n: bulat = 0;
    untuk i dari 0 sampai panjang(baris) {
        biar ln: teks = pangkas(ganti(baris[i], "\r", ""));
        kalau panjangTeks(ln) > 0 {
            biar f: []teks = pisah(ln, "|");
            kalau panjang(f) >= 9 {
                biar r: peta = peta{};
                r["nama"] = f[0];
                r["kategori"] = f[1];
                r["harga"] = f[2];
                r["stok"] = f[3];
                r["gambar"] = f[4];
                r["galeri"] = f[5];
                r["sku"] = f[6];
                r["terjual"] = f[7];
                r["deskripsi"] = f[8];
                orm_simpan(DB, model_produk(), r);
                n = n + 1;
            }
        }
    }
    cetak("  [seed] " + keTeks(n) + " produk dari produk.csv");
}
