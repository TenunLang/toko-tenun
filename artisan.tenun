// artisan — runner CLI (mirip `php artisan`).
//   tenun run artisan.tenun migrasi    buat semua tabel
//   tenun run artisan.tenun seed       isi data contoh
//   tenun run artisan.tenun layani     jalankan server web (port 8080)
// Atau via skrip tenun.json: tenun jalan migrasi | seed | layani

impor "./index.tenun";

// Handler HTTP (top-level untuk hoisting).
fungsi tangani(metode: teks, jalur: teks, badan: teks): teks {
    kembali web_tangani(metode, jalur, badan);
}

biar perintah: []teks = argumen();
kalau panjang(perintah) == 0 {
    cetak("Penggunaan: tenun run artisan.tenun [migrasi|seed|layani]");
} lain {
    biar cmd: teks = perintah[0];
    kalau cmd == "migrasi" {
        jalankanMigrasi();
    } lain {
        kalau cmd == "seed" {
            jalankanSeed();
        } lain {
            kalau cmd == "layani" {
                daftarRute();
                cetak("[toko] server di http://localhost:8080");
                layani(8080);
            } lain {
                cetak("perintah tidak dikenal: " + cmd);
            }
        }
    }
}
