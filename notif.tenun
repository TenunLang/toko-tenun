impor "socketio";

fungsi pesan(soket: bulat, data: teks): kosong {
    io_siar("pesan", data);
}

io_pada("pesan", pesan);

fungsi koneksi(soket: bulat): kosong {
    io_tangani(soket);
}
layaniSoket(3001);
